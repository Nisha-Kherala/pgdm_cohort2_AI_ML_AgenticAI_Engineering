    {
      "id": "dNz-Qm_4ExYCdGP6qa9UI",
      "type": "text",
      "x": 4670.611266430028,
      "y": 94172.94371476685,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
