      "isDeleted": false,
      "boundElements": null,
      "updated": 1791442064830,
      "created": 1791442064487,
      "link": null,
      "locked": false,
      "text": "A lender knows that 10% of borrowers miss their first EMI. It selects 20\nborrowers.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A lender knows that 10% of borrowers miss their first EMI. It selects 20 borrowers.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "1dp5BH4l87suavumxFufK",
      "type": "text",
      "x": 4580.298766430028,
      "y": 94282.26402726685,
      "width": 772.159912109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6Q",
      "roundness": null,
      "seed": 498045645,
      "version": 29,
      "versionNonce": 849748387,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791442110955,
      "created": 1791442102992,
      "link": null,
      "locked": false,
      "text": "Let X = the number who miss their first EMI. Assuming borrowers’ outcomes\nare independent and each has the same 10% probability:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let X = the number who miss their first EMI. Assuming borrowers’ outcomes are independent and each has the same 10% probability:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
